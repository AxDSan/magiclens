{
  "name": "magiclens",
  "version": "0.1.0",
  "description": "Read, select, translate and analyze the text inside any image on the web, in place.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build:all": "npm run build:chrome && npm run build:edge && npm run build:firefox && npm run build:safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "wxt zip -b chrome && wxt zip -b edge && wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint:firefox": "wxt build -b firefox && web-ext lint --source-dir .output/firefox-mv3",
    "test": "vitest run",
    "test:e2e": "wxt build -b chrome && playwright test",
    "postinstall": "wxt prepare",
    "test:firefox": "wxt build -b firefox && node tests/firefox/smoke.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:e2e && npm run test:firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "puppeteer-core": "^25.12.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "preact": "^10.29.8",
    "tesseract.js": "^7.0.0"
  }
}
